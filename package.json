{
  "name": "smartfit-ai-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @smartfit/web dev",
    "dev:mobile": "pnpm --filter @smartfit/mobile dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
